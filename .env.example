# Never commit the filled .env. Railway: set these in Variables.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
# Choose a model supporting Responses structured outputs.
OPENAI_MODEL=
BRAVE_API_KEY=
# Paid APIs are off until explicitly configured.
PAID_APIS_ENABLED=false
# Both caps must be configured to enable their corresponding paid service.
LLM_CALLS_PER_DAY=0
SEARCH_CALLS_PER_DAY=0
LLM_MAX_OUTPUT_TOKENS=5000
CONFIG_PATH=config/preferences.yaml
PROFILE_PATH=config/candidate.yaml
SOURCES_PATH=config/sources.yaml
NOTION_API_KEY=
# Enable after granting a read-only Notion integration access to Applied to companies.
NOTION_SYNC_ENABLED=false
NOTION_CONFIG_PATH=config/notion.yaml

# Railway: JSON value with preferences, candidate, sources and notion sections.
PRIVATE_CONFIG_JSON=
# For bundles over Railway's per-variable limit, split the JSON into consecutive
# chunks under 32768 characters. Use these INSTEAD of PRIVATE_CONFIG_JSON.
# Parts are joined verbatim in numeric order; unused trailing parts stay empty.
PRIVATE_CONFIG_JSON_1=
PRIVATE_CONFIG_JSON_2=
PRIVATE_CONFIG_JSON_3=
PRIVATE_CONFIG_JSON_4=
# Local only: ignored private file; do not set this path on Railway.
PRIVATE_CONFIG_PATH=
# Optional compact private search update: watchlists, policy_text, sources.
# Replaces watchlists, appends latest explicit policy, merges sources by ID.
# Keeps CV and compensation in the existing private bundle.
PRIVATE_SEARCH_CONFIG_JSON=
